PORT=4000
CORS_ORIGIN=*

# Raw Postgres connection to your Supabase project (used for existing GIS routes
# and node-pg-migrate)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

REDIS_URL=

BUILDING_PROVIDER=osm

# Optional — enables the "paid" data source in the Solar panel (Google Solar
# API buildingInsights). Leave blank to use the free NASA POWER + open-data
# estimator only. Get a key at https://developers.google.com/maps/documentation/solar/overview
GOOGLE_SOLAR_API_KEY=

# Supabase project — service role client (bypasses RLS; server-side only, never
# expose to the frontend). Used for Storage uploads, notifications, and
# activity-log writes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Gmail SMTP (transactional email for new complaints, complaint updates, and
# announcements). GMAIL_APP_PASSWORD is a Google Account "App password"
# (myaccount.google.com/apppasswords) — not your normal login password, and
# requires 2-Step Verification to be enabled on the account.
# Resend HTTPS API (recommended for Render Free, which blocks SMTP ports).
# Verify the sender domain in Resend before using an address at that domain.
RESEND_API_KEY=re_your_api_key
MAIL_FROM_EMAIL=notifications@your-domain.com

# Optional Gmail SMTP fallback for local development or paid hosting.
GMAIL_USER=your-notifications@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
MAIL_FROM_NAME=Flodata Digital Twin

# Fallback recipient for "new complaint" emails, used only if no active admin
# profiles are found in the database.
ADMIN_EMAIL=admin@your-domain.com

# Deployed frontend origins — email "Open in Admin/User Panel" buttons link
# here. Defaults (used if left blank) already point at the production
# deployments, so these only need setting for local/staging.
ADMIN_PANEL_URL=https://threed-model11-admin.onrender.com
USER_PANEL_URL=https://threed-model11.onrender.com
